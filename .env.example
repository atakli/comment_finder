# Yorum Ayıklayıcı Konfigürasyonu
# Bu dosyayı '.env' olarak kopyalayabilirsiniz: cp .env.example .env

# Yönetici Giriş Şifresi (Siteyi başkalarına açtığınızda yönetici paneline erişmek için):
ADMIN_PASSWORD=guclu_bir_sifre_belirleyin

# İsteğe bağlı LLM API Anahtarları (Burada tanımlanırsa arayüzde tekrar sormaz):
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...

# İsteğe bağlı Instagram Ayarları:
# Tarayıcıda instagram.com'a giriş yapıp F12 > Application/Depolama > Cookies > sessionid:
# INSTAGRAM_SESSIONID=...

# İsteğe bağlı Facebook Ayarları:
# Tarayıcıda facebook.com'a giriş yapıp F12 > Cookies > c_user=...; xs=...;:
# FACEBOOK_COOKIES=c_user=...; xs=...;
# Veya Meta Graph API Access Token:
# FACEBOOK_ACCESS_TOKEN=EAAB...

# İsteğe bağlı Apify API Anahtarı (Instagram ve Facebook için bulut üzerinden kazıma):
# APIFY_API_KEY=apify_api_...
